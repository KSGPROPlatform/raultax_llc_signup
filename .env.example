# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; .env.example is committed as documentation.

# --- Microsoft Entra External ID (native authentication) ---
# Native auth is a PUBLIC client flow, so there is NO client secret here.
# In the Entra admin center: App registrations -> your app -> Authentication ->
# enable public client flows AND "Enable native authentication" = Yes.

# The part before ".ciamlogin.com" (and before ".onmicrosoft.com") of your tenant.
ENTRA_SUBDOMAIN="<your-subdomain>"

# Your tenant id (GUID) OR "<your-subdomain>.onmicrosoft.com".
ENTRA_TENANT="81a1cbce-a601-4088-81fa-7405466f8ddd"

# App registration -> Overview -> Application (client) ID.
ENTRA_CLIENT_ID="<application-client-id>"

# --- Session cookie ---
# Secret used to ENCRYPT the httpOnly session cookie. Generate with:
#   openssl rand -base64 33
SESSION_SECRET=""

# --- Profile store (standalone Azure Function -> Azure SQL) ---
# The Function that mirrors each user into the database on sign-up/sign-in.
# (SQL credentials live on the FUNCTION app, not here — see azure-functions/.)
# NOTE: do NOT name these FUNCTIONS_* — Azure Static Web Apps reserves that prefix.
PROFILE_API_URL="https://<your-function-app>.azurewebsites.net/api"
PROFILE_API_KEY="<a function key from the Function App>"
