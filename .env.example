# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; .env.example is committed as documentation.

# Auth.js session secret. Generate one with:  openssl rand -base64 33
AUTH_SECRET=""

# Microsoft Entra External ID — app registration "Overview" page
AUTH_MICROSOFT_ENTRA_ID_ID="<Application (client) ID>"

# Microsoft Entra External ID — "Certificates & secrets" -> client secret VALUE
AUTH_MICROSOFT_ENTRA_ID_SECRET="<Client secret VALUE>"

# EXTERNAL ID (CIAM) issuer — note ciamlogin.com, NOT login.microsoftonline.com
#   <subdomain> = the part before .onmicrosoft.com on your tenant
#   <tenant-id> = Directory (tenant) ID GUID
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://<subdomain>.ciamlogin.com/<tenant-id>/v2.0"
